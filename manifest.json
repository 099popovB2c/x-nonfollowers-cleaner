{
  "manifest_version": 3,
  "name": "X Non-Followers Cleaner",
  "version": "1.4.0",
  "description": "Open-source X non-follower cleaner with manual, batch, timed unfollow modes and local daily safety tracking.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Non-Followers Cleaner"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "minimum_chrome_version": "111"
}
