{
  "manifest_version": 3,
  "name": "X Non-Followers Cleaner",
  "version": "1.3.1",
  "description": "Find X accounts that do not appear to follow you back, process user-selected batches, and track a local daily unfollow safety counter.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Non-Followers Cleaner"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
